    "@angular/platform-browser": "~18.2.0",
    "@angular/platform-server": "~18.2.0",
    "@angular/router": "~18.2.0",
    "@angular/ssr": "~18.2.0",
    "@primeng/themes": "^21.0.4",
    "express": "^4.18.2",
    "keycloak-js": "^26.2.0",
    "primeicons": "^7.0.0",
    "primeng": "^18.0.2",
    "rxjs": "~7.8.0",
